# expect: O222
seal mod div_asserted

# `assert` est le fix de §10.3 mais n'existe pas encore dans le parseur : ici c'est
# un nom inconnu suivi d'une comparaison nue, qui n'arrete rien hors d'un bloc
# `test`. Tant que `assert` n'est pas une instruction, rien ne decharge O222.
pub fn ratio(n: u32, d: u32) -> u32:
  d != 0
  n / d

test ratio: ratio(10, 2) == 5
